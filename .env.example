# Copy this file to .env.local and fill in your values
# For different environments, use the appropriate prefix:
# - Web (Vite): VITE_
# - Next.js: NEXT_PUBLIC_
# - Expo: EXPO_PUBLIC_
# - Server/Edge Functions: No prefix needed

# Required: Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required: Your Supabase anon key (safe to expose in client-side code)
SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key (server-side only, DO NOT expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment
NODE_ENV=development
VITE_ENV=development

# AI Gateway API Key (for AI features)
EXPO_PUBLIC_AI_GATEWAY_API_KEY=your-ai-gateway-key-here
VITE_AI_GATEWAY_API_KEY=your-ai-gateway-key-here

# Vector Database API Key (for vector search)
EXPO_PUBLIC_VECTOR_DB_API_KEY=your-vector-db-key-here
VITE_VECTOR_DB_API_KEY=your-vector-db-key-here
